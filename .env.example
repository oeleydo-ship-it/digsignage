APP_NAME=DigSignage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production only: use a long random one-time key before the first visit.
INITIAL_ADMIN_SETUP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production MySQL setup: see docs/DEPLOYMENT-MYSQL.md
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Production HTTPS: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: QUEUE_CONNECTION=redis (required for Horizon queue monitoring)
QUEUE_CONNECTION=database

# Production: CACHE_STORE=redis
CACHE_STORE=database
# CACHE_PREFIX=

# Media storage: local private disk by default. Production: MEDIA_DISK=s3 with
# the AWS_* / AWS_URL (CDN) values below so originals are delivered via signed
# object-storage URLs instead of being streamed through PHP.
# MEDIA_DISK=s3
# MEDIA_TEMPORARY_URL_MINUTES=10

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

REVERB_APP_ID=digsignage
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Queue customer notification adapters (trusted server-side webhooks).
QUEUE_SMS_WEBHOOK_URL=
QUEUE_WHATSAPP_WEBHOOK_URL=
QUEUE_PUSH_WEBHOOK_URL=

SIGNAGE_MONITOR_HEALTHY_SECONDS=120
SIGNAGE_MONITOR_WARNING_SECONDS=300
# SIGNAGE_PLAYER_MANIFEST_CACHE=20
# SIGNAGE_ANALYTICS_REPORT_CACHE=60

# Horizon (production queue dashboards at /horizon, platform admins only):
# composer require laravel/horizon && php artisan horizon:install
# Requires a Unix host (ext-pcntl, ext-posix) and QUEUE_CONNECTION=redis.
# HORIZON_PREFIX=digsignage_horizon:

BILLING_DRIVER=fake
BILLING_TRIAL_DAYS=14
PARTNER_API_RATE_PER_MINUTE=120
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
